# ── Bot ──
DISCORD_TOKEN=your_bot_token_here

# ── OAuth2 (Discord Developer Portal > OAuth2) ──
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# ── The full URL to your /callback endpoint (must match Discord portal redirect URI) ──
# Example: https://yourdomain.com/callback
OAUTH_REDIRECT_URI=https://yourdomain.com/callback

# ── The base URL of where you host the auth server / website ──
AUTH_SERVER_URL=https://yourdomain.com

# ── Port the auth server listens on ──
AUTH_PORT=3000

# ── Secret key for ,pull and list commands — change this to something long & random ──
PULL_SECRET=illegal-rest-s3cr3t-k3y-change-this-xK9mP2qL8vN4wR7

# ── Your Discord user ID — only this account can use ,pull ──
BOT_OWNER_ID=your_discord_user_id_here
